{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost-line.example/schemas/summary.schema.json",
  "title": "Ghost Line summary.json",
  "description": "Overall race counts, per-pair ride verdicts, and the list of every race today wins.",
  "type": "object",
  "required": [
    "schema",
    "definition",
    "races",
    "wins_1938",
    "wins_today",
    "photo_finishes",
    "ride_same",
    "ride_faster_today",
    "ride_slower_today",
    "pairs_without_one_seat_ride",
    "today_wins",
    "pairs",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "object",
      "description": "Maps each numeric count and today_wins to source-ID arrays from the index.json catalog. Every count is derived from the race files, so each mapping lists the race inputs (guide1938_diagram, guide1938_timetable, mta_gtfs) and method. The emitter checks ID resolution and coverage of any additional numeric field.",
      "required": [
        "races",
        "wins_1938",
        "wins_today",
        "photo_finishes",
        "ride_same",
        "ride_faster_today",
        "ride_slower_today",
        "pairs_without_one_seat_ride",
        "today_wins",
        "pairs"
      ],
      "properties": {
        "races": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "wins_1938": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "wins_today": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "photo_finishes": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "ride_same": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "ride_faster_today": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "ride_slower_today": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "pairs_without_one_seat_ride": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "today_wins": { "$ref": "#/$defs/RaceDerivedSourceIds" },
        "pairs": { "$ref": "#/$defs/RaceDerivedSourceIds" }
      },
      "additionalProperties": { "$ref": "#/$defs/SourceIds" }
    },
    "schema": {
      "type": "string",
      "const": "ghostline.summary.v1"
    },
    "definition": {
      "type": "string",
      "description": "Human-readable description of the race parameters, e.g. the slider range and photo-finish band."
    },
    "races": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of races across all pairs."
    },
    "wins_1938": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of races won by the 1938 trolley."
    },
    "wins_today": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of races won by today's bus."
    },
    "photo_finishes": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of races decided within the 1.0-minute photo-finish band."
    },
    "ride_same": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pairs whose ride verdict is 'same'."
    },
    "ride_faster_today": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pairs where today's ride is faster."
    },
    "ride_slower_today": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pairs where today's ride is slower."
    },
    "pairs_without_one_seat_ride": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pairs for which no one-seat trip was found at the configured radius."
    },
    "today_wins": {
      "type": "array",
      "description": "Every individual race where today wins, one entry per race minute.",
      "items": {
        "$ref": "#/$defs/TodayWin"
      }
    },
    "pairs": {
      "type": "array",
      "description": "One entry per directed pair: race counts and the ride verdict (race-brief 5.6).",
      "items": {
        "$ref": "#/$defs/PairVerdict"
      }
    }
  },
  "$defs": {
    "SourceIds": {
      "type": "array",
      "description": "Nonempty list of source IDs from the index.json catalog.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "guide1938_diagram",
          "guide1938_timetable",
          "guide1938_route",
          "mta_gtfs",
          "osm",
          "method"
        ]
      }
    },
    "RaceDerivedSourceIds": {
      "$ref": "#/$defs/SourceIds",
      "description": "A value derived from the race rows. Must include the race inputs and the method.",
      "allOf": [
        { "contains": { "const": "guide1938_diagram" } },
        { "contains": { "const": "guide1938_timetable" } },
        { "contains": { "const": "mta_gtfs" } },
        { "contains": { "const": "method" } }
      ]
    },
    "PairVerdict": {
      "type": "object",
      "required": [
        "origin",
        "dest",
        "races",
        "wins_1938",
        "wins_today",
        "photo_finishes",
        "ride_1938",
        "ride_today_median",
        "delta",
        "ride_verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "description": "Slug of the origin corner." },
        "dest": { "type": "string", "description": "Slug of the destination corner." },
        "races": { "type": "integer", "minimum": 0, "description": "Races counted for this pair (t >= covered_from)." },
        "wins_1938": { "type": "integer", "minimum": 0 },
        "wins_today": { "type": "integer", "minimum": 0 },
        "photo_finishes": { "type": "integer", "minimum": 0 },
        "ride_1938": { "type": "number", "exclusiveMinimum": 0, "description": "1938 in-vehicle ride in minutes." },
        "ride_today_median": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Median of today ride minutes over the counted races; null when there is no one-seat ride."
        },
        "delta": {
          "type": ["number", "null"],
          "description": "ride_today_median minus ride_1938; null when there is no one-seat ride."
        },
        "ride_verdict": {
          "enum": ["same", "faster today", "slower today", null],
          "description": "Ride verdict; null when there is no one-seat ride."
        }
      }
    },
    "TodayWin": {
      "type": "object",
      "required": ["origin", "dest", "t", "margin"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "description": "Slug of the origin corner."
        },
        "dest": {
          "type": "string",
          "description": "Slug of the destination corner."
        },
        "t": {
          "type": "string",
          "description": "Slider time in HH:MM format.",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "description": "Margin of victory in minutes (always positive; the loser's total minus the winner's total)."
        }
      }
    }
  }
}
