{
  "name": "ghost-line-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "screens": "playwright test tests/e2e/screens.spec.ts",
    "test:e2e": "playwright test --project=phone --project=laptop",
    "test:e2e:webkit": "playwright test --project=phone-webkit --project=laptop-webkit",
    "check:size": "node scripts/check-size.ts",
    "perf": "playwright test --project=perf"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.1",
    "fast-check": "^4.10.3",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "maplibre-gl": "^6.19.0"
  }
}
